# 由 moox-cli setup deploy 按服务目录渲染成 ~/.config/systemd/user/moox-seaweedfs.service；不要手工改，重新部署会覆盖。
# 启动顺序只用 After= 排先后，不等就绪：依赖没起来时组件自己重试或退出，5 秒后再拉起。
# After= 只写同一台主机上的组件；不等网络就绪的系统目标（用户单元里它不起作用）。
[Unit]
Description=MooX seaweedfs
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/data/moox/data/seaweedfs
EnvironmentFile=/data/moox/secrets/env/seaweedfs.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
ExecStart=/data/moox/bin/weed -logtostderr=true server -dir=/data/moox/data/seaweedfs -ip=127.0.0.1 -ip.bind=127.0.0.1 -master.port=11470 -master.port.grpc=21470 -master.telemetry=false -master.volumeSizeLimitMB=1024 -volume.port=11471 -volume.port.grpc=21471 -volume.max=0 -filer -filer.port=11472 -filer.port.grpc=21472 -s3 -s3.port=11473 -s3.port.grpc=21473 -s3.port.iceberg=0 -s3.port.lance=0 -s3.config=/data/moox/secrets/seaweedfs/s3.json
Restart=always
RestartSec=5
TimeoutStopSec=120
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
