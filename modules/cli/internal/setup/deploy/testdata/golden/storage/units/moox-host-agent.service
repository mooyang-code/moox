# 由 moox-cli setup deploy 按服务目录渲染成 ~/.config/systemd/user/moox-host-agent.service；不要手工改，重新部署会覆盖。
# 启动顺序只用 After= 排先后，不等就绪：依赖没起来时组件自己重试或退出，5 秒后再拉起。
# After= 只写同一台主机上的组件；不等网络就绪的系统目标（用户单元里它不起作用）。
[Unit]
Description=MooX host-agent
After=moox-host-gateway.service moox-eventbus.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/data/moox/data/host-agent
EnvironmentFile=/data/moox/secrets/env/host-agent.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
ExecStart=/data/moox/bin/moox-host-agent -config=/data/moox/config/host-agent/app.yaml -conf=/data/moox/config/host-agent/trpc_go.yaml
Restart=always
RestartSec=5
TimeoutStopSec=120
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=default.target
