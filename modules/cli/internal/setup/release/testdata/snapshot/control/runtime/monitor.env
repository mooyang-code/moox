# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-monitor'
COMPONENT_WORKDIR='monitor'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=monitor' 'MOOX_INSTANCE_ID=monitor@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-monitor' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml' 'MOOX_DATASET_HEALTH_POLICY=/data/moox/prod/current/monitor/config/dataset-health-policy.yaml')
COMPONENT_SECRET_ENV=('health-auth.env' 'storage-internal-auth.env' 'notification.env')
COMPONENT_DATA_DIRS=('data/monitor')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11409'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
component_prestart() {
  "${RELEASE}"/'bin/moox-monitor-cli' 'init' '--db-path' '/data/moox/prod/data/monitor/monitor.db'
}
