# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-cloudnode'
COMPONENT_WORKDIR='cloudnode'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=cloudnode' 'MOOX_INSTANCE_ID=cloudnode@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-cloudnode' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml')
COMPONENT_SECRET_ENV=('health-auth.env' 'notification.env')
COMPONENT_DATA_DIRS=('data/cloudnode')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11411'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
COMPONENT_NEEDS_METADATA='0'
component_prestart() {
  "${RELEASE}"/'bin/moox-cloudnode-cli' 'init' '--db-path' '/data/moox/prod/data/cloudnode/moox_cloudnode.db'
}
