# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-collector'
COMPONENT_WORKDIR='collector'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=collector' 'MOOX_INSTANCE_ID=collector@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-collector' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml' 'MOOX_STOCK_CN_SOURCE_CONFIG_DIR=/data/moox/prod/current/collector/config/sources/stockcn')
COMPONENT_SECRET_ENV=('health-auth.env' 'storage-internal-auth.env')
COMPONENT_DATA_DIRS=('data/collector')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11412'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='120'
COMPONENT_STOP_TIMEOUT='30'
COMPONENT_NEEDS_METADATA='1'
component_prestart() {
  "${RELEASE}"/'bin/moox-collector-cli' 'init' '--db-path' '/data/moox/prod/data/collector/moox_collector.db' '--seed-file' "${RELEASE}"/'collector/config/setup/collection-tasks.yaml'
}
