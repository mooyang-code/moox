# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-admin'
COMPONENT_WORKDIR='admin'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=admin' 'MOOX_INSTANCE_ID=admin@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-admin' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml' 'MOOX_ADMIN_DB_PATH=/data/moox/prod/data/admin/admin.db' 'MOOX_ADMIN_ENCRYPTION_KEY_FILE=/data/moox/prod/secrets/admin-encryption-key' 'MOOX_PKI_CA_FILE=/data/moox/prod/secrets/pki/ca.crt' 'MOOX_EVENTBUS_CA_FILE=/data/moox/prod/secrets/eventbus/ca.pem')
COMPONENT_SECRET_ENV=('health-auth.env' 'admin-jwt.env' 'storage-internal-auth.env' 'notification.env')
COMPONENT_DATA_DIRS=('data/admin')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11010'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
component_prestart() {
  "${RELEASE}"/'bin/moox-admin-cli' 'init' '--db-path' '/data/moox/prod/data/admin/admin.db'
}
