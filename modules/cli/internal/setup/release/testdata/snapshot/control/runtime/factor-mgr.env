COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
component_prestart() {
  python3 -c 'import pandas, numpy' >/dev/null 2>&1 || { echo "因子管理需要安装了 pandas 和 numpy 的 python3（modules/factor/pyworker/runtime-requirements.txt）" >&2; exit 1; }
}
