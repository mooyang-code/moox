COMPONENT_BINARY='moox-factor-mgr'
COMPONENT_WORKDIR='factor-mgr'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=factor-mgr' 'MOOX_INSTANCE_ID=factor-mgr@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-factor-mgr' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml' 'MOOX_FACTOR_DB_PATH=/data/moox/prod/data/factor-mgr/factor.db')
COMPONENT_SECRET_ENV=('health-auth.env' 'storage-internal-auth.env')
COMPONENT_DATA_DIRS=('data/factor-mgr')
