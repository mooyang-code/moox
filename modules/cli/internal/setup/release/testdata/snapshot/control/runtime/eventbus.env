# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-eventbus'
COMPONENT_WORKDIR='eventbus'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=eventbus' 'MOOX_INSTANCE_ID=eventbus@control' 'MOOX_NODE_ID=control' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-eventbus' 'MOOX_EVENTBUS_NATS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://127.0.0.1:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/prod/secrets/eventbus/metrics-publisher.yaml')
COMPONENT_SECRET_ENV=('health-auth.env')
COMPONENT_DATA_DIRS=('data/eventbus')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11419'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
component_prestart() {
  "${RELEASE}"/'bin/moox-admin-cli' 'init' '--db-path' '/data/moox/prod/data/admin/admin.db'
  "${RELEASE}"/'bin/moox-admin-cli' 'eventbus-credentials' 'ensure' '--db-path' '/data/moox/prod/data/admin/admin.db' '--encryption-key-file' '/data/moox/prod/secrets/admin-encryption-key' '--nats-url' 'tls://203.0.113.10:4222'
  "${RELEASE}"/'bin/moox-admin-cli' 'eventbus-credentials' 'export' '--db-path' '/data/moox/prod/data/admin/admin.db' '--encryption-key-file' '/data/moox/prod/secrets/admin-encryption-key' '--nats-url' 'tls://203.0.113.10:4222' '--output-dir' '/data/moox/prod/secrets/eventbus'
}
