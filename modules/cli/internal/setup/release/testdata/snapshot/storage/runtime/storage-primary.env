# 由 moox-cli 生成，请勿手工修改。
COMPONENT_BINARY='moox-storage-primary'
COMPONENT_WORKDIR='storage-primary'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=storage-primary' 'MOOX_INSTANCE_ID=storage-primary@storage' 'MOOX_NODE_ID=storage' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-storage-primary' 'MOOX_EVENTBUS_NATS_URL=tls://203.0.113.10:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://203.0.113.10:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/storage/secrets/eventbus/metrics-publisher.yaml' 'MOOX_STORAGE_ROLE=primary' 'MOOX_STORAGE_HOME=/data/moox/storage/data/storage' 'MOOX_STORAGE_CONFIG=/data/moox/storage/current/storage-primary/config/storage.yaml' 'MOOX_STORAGE_EVENTBUS_URL=tls://203.0.113.10:4222' 'MOOX_STORAGE_EVENTBUS_CREDENTIAL_FILE=/data/moox/storage/secrets/eventbus/storage-eventbus.yaml')
COMPONENT_SECRET_ENV=('health-auth.env' 'storage-internal-auth.env' 'storage-node-auth.env')
COMPONENT_DATA_DIRS=('data/storage')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='20210'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='120'
component_prestart() {
  "${RELEASE}"/'bin/moox-storage-cli' 'init' '--storage-conf=/data/moox/storage/current/storage-primary/config/storage.yaml' '--schema-path='"${RELEASE}"/'storage-primary/schema/metadata.sql'
}
component_poststart() {
  "${RELEASE}"/'bin/moox-storage-cli' 'register-node' '--metadata-target' 'ip://127.0.0.1:20100' '--node-id' 'storage-node-0' '--service-target' 'ip://127.0.0.1:20107' '--name' '数据节点'
}
