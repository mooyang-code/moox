COMPONENT_BINARY='moox-trade'
COMPONENT_WORKDIR='trade'
COMPONENT_ARGS=('-conf=config/trpc_go.yaml')
COMPONENT_ENV=('MOOX_SERVICE_NAME=trade' 'MOOX_INSTANCE_ID=trade@compute-1' 'MOOX_NODE_ID=compute-1' 'MOOX_VERSION=test' 'MOOX_OTEL_SERVICE_NAME=moox-trade' 'MOOX_EVENTBUS_NATS_URL=tls://203.0.113.10:4222' 'MOOX_METRICS_EVENTBUS_URL=tls://203.0.113.10:4222' 'MOOX_METRICS_EVENTBUS_CREDENTIAL_FILE=/data/moox/compute-1/secrets/eventbus/metrics-publisher.yaml')
COMPONENT_SECRET_ENV=('health-auth.env')
COMPONENT_DATA_DIRS=('data/trade')
COMPONENT_HEALTH_KIND='readyz'
COMPONENT_HEALTH_PORT='11210'
COMPONENT_HEALTH_URL=''
COMPONENT_STARTUP_GRACE='60'
COMPONENT_STOP_TIMEOUT='30'
COMPONENT_NEEDS_METADATA='0'
component_prestart() {
  "${RELEASE}"/'bin/moox-trade-cli' 'init' '--db-path' '/data/moox/compute-1/data/trade/moox_trade.db'
}
