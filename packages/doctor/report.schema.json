{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctor.moox.dev/schema/report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "finished_at",
    "conclusion",
    "checks",
    "root_cause_check_ids",
    "blocking_check_ids",
    "missing_observations",
    "manifest_checksum"
  ],
  "properties": {
    "schema_version": { "const": "doctor.moox.dev/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["bootstrap", "diagnose"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "conclusion": { "enum": ["HEALTHY", "DEGRADED", "UNHEALTHY", "INCONCLUSIVE"] },
    "checks": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/check" }
    },
    "root_cause_check_ids": { "type": "array", "items": { "type": "string" } },
    "blocking_check_ids": { "type": "array", "items": { "type": "string" } },
    "missing_observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "manifest_checksum": { "type": "string" }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "summary"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "maxLength": 2048 },
        "digest": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "required"],
      "properties": {
        "check_id": { "type": "string" },
        "status": { "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "BLOCKED", "SKIPPED"] },
        "summary": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "BLOCKED", "SKIPPED"] },
        "summary": { "type": "string" },
        "error": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "observations": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/observation" } },
        "dependency_context": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "recovery_action_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
