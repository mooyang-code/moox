[admin]
username = "admin"
password = ""

[tencent_cloud]
secret_id = ""
secret_key = ""
region = "ap-guangzhou"

[eventbus]
public_address = ""
port = 4222
tls_enabled = true

# 所有运行时目录使用云磁盘 /data 下的统一根目录。
[paths]
deploy_root = "/data/moox"
control_root = "/data/moox/prod"
storage_root = "/data/moox/storage"

# 每个本地 .log 文件达到上限后保留尾部并原地截断，避免 stdout/stderr
# 或框架日志无限占用磁盘。健康检查每分钟执行一次滚动维护。
[local_logs]
max_size_mb = 50
backup_count = 5

# View 维护策略。每个时序序列超过 max_periods_per_series 即触发 A/B 重建，
# 新 View 尝试回溯 rebuild_lookback_periods 根已完成 K 线；历史不足时使用已有数据激活，
# 后续由实时事件继续补齐。
[storage_view]
maintenance_check_interval = "1m"
rebuild_lookback_periods = 1000
max_periods_per_series = 2000
max_view_file_bytes = 1073741824

# 系统监控 View 可单独配置；省略字段继承 storage_view 全局值。
[storage_view.system_monitor]
max_periods_per_series = 2000

# 单个 View 覆盖优先级最高；省略字段继承 system_monitor 或全局值。
[[storage_view.views]]
space_id = "crypto_market"
view_id = "binance_spot_kline_1m_view"
rebuild_lookback_periods = 1000
max_periods_per_series = 2000

# 留空时仍采集和展示监控数据，但不发送站外告警。
[notification]
channel_type = "wecom"
webhook_url = ""

# setup init 导入本地 Python 因子，并建立默认 Source View 绑定。
# outputs 同时作为结果列的 display_name，例如 bias_20、ma_20。
# 关闭默认因子导入请设置 factors.enabled = false；也可以复制条目改成自己的 View、频率和参数。
[factors]
enabled = false
source_dir = "./examples/factors"

[[factors.items]]
factor_id = "bias"
file = "timeseries/bias.py"
name = "bias"
input_columns = ["close"]
outputs = ["bias_5", "bias_20"]
params_json = '{"windows":[5,20]}'
lookback_periods = 20
space_id = "crypto_market"
source_view_id = "binance_spot_kline_1m_view"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "cci"
file = "timeseries/cci.py"
name = "cci"
input_columns = ["high", "low", "close"]
outputs = ["cci"]
params_json = '{"window":20}'
lookback_periods = 20
space_id = "crypto_market"
source_view_id = "binance_spot_kline_1m_view"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "ma"
file = "timeseries/ma.py"
name = "ma"
input_columns = ["close"]
outputs = ["ma_5", "ma_20"]
params_json = '{"windows":[5,20]}'
lookback_periods = 20
space_id = "crypto_market"
source_view_id = "binance_spot_kline_1m_view"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "sma"
file = "timeseries/sma.py"
name = "sma"
input_columns = ["close"]
outputs = ["sma_5", "sma_20"]
params_json = '{"windows":[5,20],"m":1}'
# SMA is recursive. 600 periods provide a 30x warm-up for SMA20 so stateless
# period tasks converge to the continuous-series value within double precision.
lookback_periods = 600
space_id = "crypto_market"
source_view_id = "binance_spot_kline_1m_view"
freq = "1m"
subject_mode = "all"
status = "enabled"

# 短时行情 SCF 按 Space 独立发布、独立消费任务。每个 Space 都必须有独立
# package_config_dir、package_name 和 function_prefix，避免跨空间混用数据源配置。
[scf_fetcher]
enabled = false

[[scf_fetcher.spaces]]
space_id = "crypto_market"
entrypoint = "crypto_market"
package_config_dir = "scf/crypto_market"
package_name = "moox-collector-crypto-market"
namespace = "default"
runtime = "Go1"
function_prefix = "moox-fetcher-crypto-market"
# Timer SCF 总数。crypto_market 默认 60；stock_cn 必须显式配置。
# region.function_count = 0 时按总数在启用地域间自动均分（每地域最多 50）。
timer_function_count = 60
# SCF Timer 每次直接访问该 Storage tRPC 地址，不再请求 Collector 配置接口。
storage_gateway_node_id = "control"
storage_rpc_gateway_target = "ip://106.53.107.122:11003"
memory_size = 64
timeout_seconds = 15
realtime_batch_size = 10
realtime_bar_limit = 3
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

[[scf_fetcher.spaces.regions]]
region = "ap-singapore"
display_name = "亚太东南（新加坡）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-singapore"
cloud_account_name = "Tencent SCF Singapore"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-singapore-<tencent-app-id>"

[[scf_fetcher.spaces.regions]]
region = "ap-tokyo"
display_name = "亚太东北（东京）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-tokyo"
cloud_account_name = "Tencent SCF Tokyo"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-tokyo-<tencent-app-id>"

# A 股 1m 多源采集默认发布 200 个 Timer。四个启用地域各自动分配 50 个；
# 发布后必须跨全部 Timer 执行 probe-egress，确认 200 个非空且互不重复的公网 IP，
# 才能手工启用 examples/setup/default/collector-rules.yaml 中的 stock_cn 规则。
[[scf_fetcher.spaces]]
space_id = "stock_cn"
entrypoint = "stock_cn"
package_config_dir = "scf/stock_cn"
package_name = "moox-collector-stock-cn"
cls_cloud_account_id = "tencent-scf-guangzhou"
namespace = "default"
runtime = "Go1"
function_prefix = "moox-fetcher-stock-cn"
timer_function_count = 200
# 单个 stock_cn Timer 的实测安全 subject 上限，超限时 Collector 拒绝发布。
measured_safe_group_size = 30
storage_gateway_node_id = "control"
storage_rpc_gateway_target = "ip://106.53.107.122:11003"
memory_size = 64
timeout_seconds = 15
# 全市场 Instrument 快照实测约 25 秒；仅 Invoke 辅助函数使用该独立超时。
instrument_invoke_timeout_seconds = 60
realtime_batch_size = 10
realtime_bar_limit = 3
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

[[scf_fetcher.spaces.regions]]
region = "ap-guangzhou"
display_name = "华南（广州）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-guangzhou"
cloud_account_name = "Tencent SCF Guangzhou"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-guangzhou-<tencent-app-id>"

[[scf_fetcher.spaces.regions]]
region = "ap-shanghai"
display_name = "华东（上海）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-shanghai"
cloud_account_name = "Tencent SCF Shanghai"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-shanghai-<tencent-app-id>"

[[scf_fetcher.spaces.regions]]
region = "ap-beijing"
display_name = "华北（北京）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-beijing"
cloud_account_name = "Tencent SCF Beijing"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-beijing-<tencent-app-id>"

[[scf_fetcher.spaces.regions]]
region = "ap-chengdu"
display_name = "西南（成都）"
enabled = true
function_count = 0
cloud_account_id = "tencent-scf-chengdu"
cloud_account_name = "Tencent SCF Chengdu"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_bucket = "moox-scf-chengdu-<tencent-app-id>"

[control_host]
name = "control"
address = ""
port = 22
username = "ubuntu"
password = ""
# Raw public IPs normally cannot obtain a public ACME certificate. Use the
# bundled Caddy internal CA in that case; omit this field for host-based auto.
tls_mode = "auto"

[compile_host]
name = ""
address = ""
port = 0
username = ""
password = ""

[[other_hosts]]
name = "compute-1"
address = ""
port = 22
username = "ubuntu"
password = ""

# moox-cli renders the non-sensitive resolver fields below into Trade's
# config/app.yaml. When enabled, trade_node is also the dedicated Trade
# execution host; deploy-control records its TradeConsole endpoint in the
# control-plane route so the browser does not fall back to 127.0.0.1:11200.
# setup deploy-service binds the dedicated Trade listener on all interfaces
# because the SSH/public address may be NAT'ed; restrict TCP 11200 in the
# cloud firewall to control_host before enabling real order operations.
# Trade does not read this full custom.toml directly.
[dns_resolver]
enabled = false
trade_node = "compute-1"
refresh_interval_seconds = 300
request_timeout_ms = 3000
lookup_timeout_ms = 1500
probe_timeout_ms = 500
probe_port = 443
cache_ttl_seconds = 300
max_ips_per_domain = 4
domains = ["data-api.binance.vision", "api.binance.com", "fapi.binance.com"]
