# Rendered by scripts/deploy/deploy-archive-worker.sh into
# ~/.config/systemd/user/moox-seaweedfs.service.
# 内置对象存储：只给本机 archive-worker 用，所有端口只听 127.0.0.1；关掉遥测、Iceberg 与 Lance，日志进 journal。
[Unit]
Description=MooX built-in object store (SeaweedFS) for archive-worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__SW__
ExecStart=__SW__/bin/weed -logtostderr=true server -dir=__SW__/data -ip=127.0.0.1 -ip.bind=127.0.0.1 -master.port=11460 -master.port.grpc=21460 -master.telemetry=false -master.volumeSizeLimitMB=1024 -volume.port=11461 -volume.port.grpc=21461 -volume.max=0 -filer -filer.port=11462 -filer.port.grpc=21462 -s3 -s3.port=11463 -s3.port.grpc=21463 -s3.port.iceberg=0 -s3.port.lance=0 -s3.config=__SW__/config/s3.json
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=default.target
