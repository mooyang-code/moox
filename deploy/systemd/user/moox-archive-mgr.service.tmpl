# Rendered by scripts/deploy/deploy-archive-mgr.sh into
# ~/.config/systemd/user/moox-archive-mgr.service.
# archive-mgr 不由 moox-runtime 管理：生产的 moox-runtime 内嵌的是 10-11 部署时的服务目录，不认识它。
[Unit]
Description=MooX archive manager
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__/archive-mgr
EnvironmentFile=__ROOT__/secrets/archive-mgr.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
ExecStart=__ROOT__/bin/moox-archive-mgr -config __ROOT__/archive-mgr/config/app.yaml -conf __ROOT__/archive-mgr/config/trpc_go.yaml
Restart=always
RestartSec=10
StandardOutput=append:__ROOT__/archive-mgr/logs/archive-mgr.log
StandardError=append:__ROOT__/archive-mgr/logs/archive-mgr.log

[Install]
WantedBy=default.target
