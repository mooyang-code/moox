# Rendered by scripts/deploy/deploy-factor-engine.sh into
# ~/.config/systemd/user/moox-factor-engine.service.
[Unit]
Description=MooX factor compute engine
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
EnvironmentFile=__SECRETS__/health-auth.env
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
ExecStart=__ROOT__/bin/moox-factor-engine serve -config __ROOT__/config/engine.yaml -conf __ROOT__/config/trpc_go.engine.yaml
Restart=always
RestartSec=10
StandardOutput=append:__ROOT__/logs/factor-engine.log
StandardError=append:__ROOT__/logs/factor-engine.log

[Install]
WantedBy=default.target
