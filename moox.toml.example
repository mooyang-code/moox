[admin]
username = "admin"
password = ""

[tencent_cloud]
secret_id = ""
secret_key = ""
region = "ap-guangzhou"

[eventbus]
port = 4222
tls_enabled = true

# 只支持 all / new，默认 all。
[observability]
# deliver_policy = "all"

# 所有运行时目录使用云磁盘 /data 下的统一根目录。
[paths]
deploy_root = "/data/moox"
control_root = "/data/moox/prod"
storage_root = "/data/moox/storage"

# 每个本地 .log 文件达到上限后保留尾部并原地截断，避免 stdout/stderr
# 或框架日志无限占用磁盘。健康检查每分钟执行一次滚动维护。
[local_logs]
max_size_mb = 50
backup_count = 5

# View 只按根数保留：每个时序序列保留最近 view_rows_per_series 根已完成 K 线，历史不足时用已有数据激活，
# 后续由实时事件补齐。
# Dataset 原始数据按 (空间, 频率) 保留：空间配置优先，没有时用 defaults；defaults 必须覆盖全部频率。
# 取值为 <n>h、<n>d 或 forever。保留期缩短会删除数据。
[storage_retention]
view_rows_per_series = 10000  # 每个序列 View 保留最近 N 根；更旧的行每 2 分钟定时删除

# 7×24 小时交易的空间（crypto 等，以及没有单独配置的空间）
[storage_retention.defaults]
"30s" = "90h"
"1m" = "35d"  # 要装得下默认因子 EMA 的最大回看 49995 根（约 34.7 天）
"5m" = "35d"
"15m" = "105d"
"30m" = "210d"
"1h" = "420d"
"4h" = "1700d"
"1d" = "forever"
"1w" = "forever"
"1mo" = "forever"

# 有交易时段的市场同样根数需要更多自然日
[storage_retention.spaces.stockcn]
"1m" = "60d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.stockhk]
"1m" = "45d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.stockus]
"1m" = "40d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.mooxsys]
"30s" = "48h"
"1m" = "7d"

# View 维护的检查节奏与单个 View 文件的告警线（超过只告警，不动数据）。
[storage_view]
maintenance_check_interval = "1m"
max_view_file_bytes = 4294967296

# View 按空间 × 频率限制最长历史：data_time 早于“当前时间 − 期限”的行不写入 View，
# 补采、导入、因子历史重算带来的旧行同样丢弃（Dataset 与因子本地存储照常保留全部历史）。
# 期限写法同 [storage_retention]；要装得下 view_rows_per_series 根（默认值恰好装下 1 万根）。
# 已在 View 里的旧行由定时删除按每序列根数删掉。
[storage_view.max_age.defaults]
"30s" = "90h"
"1m" = "7d"
"5m" = "35d"
"15m" = "105d"
"30m" = "210d"
"1h" = "420d"
"4h" = "1700d"
"1d" = "forever"
"1w" = "forever"
"1mo" = "forever"

[storage_view.max_age.spaces.stockcn]
"1m" = "60d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_view.max_age.spaces.stockhk]
"1m" = "45d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_view.max_age.spaces.stockus]
"1m" = "40d"
"5m" = "300d"
"15m" = "900d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_view.max_age.spaces.mooxsys]
"30s" = "48h"
"1m" = "7d"

# Collector 的旧执行明细、terminal retry 和 period snapshot 按独立期限回收。
# 活动工作以及未获 Storage complete/degraded 确认的 K 线目标不会被删除。
# 清理在每个周期的 maintenance_offset 处开始，且必须在下一个整点前结束
# （offset + timeout <= interval），避免与整点的 K 线调度争用 SQLite 连接。
[collector_retention]
maintenance_interval = "1m"
maintenance_offset = "35s"
maintenance_timeout = "20s"
max_rows_per_pass = 50000

# 告警推送渠道，初始化前必填：没有推送地址时监控只展示不通知，等于没有告警。
# channel_type 为 wecom 或 feishu，webhook_url 是对应群机器人的地址；Monitor 首次建库时据此写入。
[notification]
channel_type = "wecom"
webhook_url = ""

# setup init 导入因子：先导入因子定义，再按任务建立因子任务并把成员加入任务、按 status 启用。
# 定义（factors.definitions）引用 source_dir 下 YAML 因子库文件里的一个因子（factor_id + file），
# 展示名与表达式都来自库文件，类型、输入列、输出列与回看由 FactorMgr 编译得到；定义是全局的，不含数据集、
# 频率和状态。
# 因子任务（factors.tasks）读一个源数据集的一个频率，一个源数据集可以有多个任务：
#   id           任务 ID，ftask_ 加小写字母、数字、下划线组成的后缀；
#   name         展示名，直接用作结果数据集的名称（含汉字、不超过 10 个字、空间内唯一）；
#   members      任务的成员，内嵌在任务里：factor 引用定义；params 是固定成员的固定参数，没给的参数取定义的默认值；
#                var = true 是可变成员，参数由关联的策略实例逐期提交，params 是它的默认参数；status 缺省为 enabled。
# 成员键由参数推导，不在配置里写：参数全为默认值时就是因子 ID，否则是 因子ID__值1_值2…，可变成员是 因子ID__var。
# 结果列名是成员键，多输出因子再加 __输出名；setup factors 会逐项打印已存在 / 新建 / 冲突，以及每个成员的成员键和列名。
# 同一个因子可以用不同的固定参数多次加入同一个任务，固定参数加成员之后不再改，要换参数请另加一个成员。
# 默认因子：xbx.yaml 里的 bias、cci、min_max、quote_volume_mean，以及 common.yaml 里的常用技术指标
# （MA、EMA、MACD、RSI、ROC、BOLL、ATR、收益率波动、VWAP）。
# 关闭默认因子导入请设置 factors.enabled = false；也可以在因子库里新增定义，或复制任务改成自己的数据集与频率。
[factors]
enabled = false
source_dir = "./modules/factor/factors"

# 每个采集任务独占一个结果数据集，ID 由任务 ID 派生为 dataset_<task_id>
# （见 config/setup/collection-tasks.yaml）：下面两个分别读币安现货、合约 1m 任务的结果。
# 固定参数、可变成员的写法示例（加进任务的 members 里即可，不要和任务里已有的同一成员重复）：
#   { factor = "ema", params = { span = 20, warmup = 50000 } },   # 成员键 ema__20_50000
#   { factor = "ma", var = true },                                 # 成员键 ma__var，参数由关联的策略实例逐期提交
[[factors.tasks]]
id = "ftask_spot_1m"
name = "现货一分钟"
space_id = "crypto"
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
members = [
  { factor = "bias" },
  { factor = "cci" },
  { factor = "min_max" },
  { factor = "quote_volume_mean" },
  { factor = "ma" },
  { factor = "ema" },
  { factor = "macd" },
  { factor = "rsi" },
  { factor = "roc" },
  { factor = "boll" },
  { factor = "atr" },
  { factor = "atr_pct" },
  { factor = "return_std" },
  { factor = "vwap" },
]

[[factors.tasks]]
id = "ftask_swap_1m"
name = "合约一分钟"
space_id = "crypto"
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
members = [
  { factor = "bias" },
  { factor = "cci" },
  { factor = "min_max" },
  { factor = "quote_volume_mean" },
  { factor = "ma" },
  { factor = "ma", params = { window = 5 } },   # 成员键 ma__5、ma__10：默认展示策略 dual_ma_swap_1m 的快线与慢线
  { factor = "ma", params = { window = 10 } },
  { factor = "ema" },
  { factor = "macd" },
  { factor = "rsi" },
  { factor = "roc" },
  { factor = "boll" },
  { factor = "atr" },
  { factor = "atr_pct" },
  { factor = "return_std" },
  { factor = "vwap" },
]

[[factors.definitions]]
factor_id = "bias"
file = "xbx.yaml"

[[factors.definitions]]
factor_id = "cci"
file = "xbx.yaml"

[[factors.definitions]]
factor_id = "min_max"
file = "xbx.yaml"

[[factors.definitions]]
factor_id = "quote_volume_mean"
file = "xbx.yaml"

[[factors.definitions]]
factor_id = "ma"
file = "common.yaml"

[[factors.definitions]]
factor_id = "ema"
file = "common.yaml"

[[factors.definitions]]
factor_id = "macd"
file = "common.yaml"

[[factors.definitions]]
factor_id = "rsi"
file = "common.yaml"

[[factors.definitions]]
factor_id = "roc"
file = "common.yaml"

[[factors.definitions]]
factor_id = "boll"
file = "common.yaml"

[[factors.definitions]]
factor_id = "atr"
file = "common.yaml"

[[factors.definitions]]
factor_id = "atr_pct"
file = "common.yaml"

[[factors.definitions]]
factor_id = "return_std"
file = "common.yaml"

[[factors.definitions]]
factor_id = "vwap"
file = "common.yaml"

# SCF 定时触发采集（Timer 模式）：声明哪些空间、市场在哪些地域运行，以及这些地域的函数网络。
# setup deploy 据此渲染 Collector 的 scf_regions / scf_markets / scf_plan；setup init 登记云账号、开通日志服务（CLS）、
# 为每个空间上传代码包。函数的数量、标的分配与定时器由 Collector 按任务与标签成员自动创建和维护，
# 代码包按名称取最新版本：升级时执行 `moox-cli collector function upload`，不需要改配置或重启。
# 云账号在 [scf_plan.cloud_account] 声明（account_id、account_name、credential_secret_id、app_id、cos_region、cos_bucket）。
[scf_plan]
enabled = false
# memory_mb = 128               # 每个函数内存，默认 128
# symbols_per_function = 50     # 每个函数负责的标的数，默认 50
# assumed_egress_ips = 1        # 函数出口 IP 个数的估计（用 moox-cli collector function probe-egress 实测），只用于频控估算与告警

# [scf_plan.cloud_account]
# account_id = "tencent-scf"
# account_name = "Tencent SCF"
# credential_secret_id = "AKID..."
# app_id = "1255..."
# cos_region = "ap-guangzhou"
# cos_bucket = "moox-scf-guangzhou-<app_id>"

# 函数在地域 VPC 内运行，通过同地域主机的私网地址访问 Access：
# 该地域必须有一台 [hosts.<id>] 配置了 region 与 private_address、并在 [deployments] 里带 access 组件。
# [scf_plan.regions.ap-hongkong]
# vpc_id = "vpc-xxxxxxxx"
# subnet_id = "subnet-xxxxxxxx"
# access_host = "overseas"   # 同地域有多台带私网地址的 access 主机时必须指定入口主机

# [[scf_plan.spaces]]
# space_id = "crypto"
# # package_name 默认 moox-collector-<space>-plan，namespace 默认 moox-<space>-plan，均可覆盖
# # 新数据集的采集方式初值：crypto 默认 default_ingest = "stream"、default_executor = "local"（WS 推送，补采走海外机本地执行端），
# # 其他空间默认 "pull" + "scf"。之后以 Collector 库为准，用 moox-cli collector ingest-mode set 切换。
# default_ingest = "stream"
# default_executor = "local"
# [scf_plan.spaces.markets]
# spot = ["ap-hongkong"]
# swap = ["ap-hongkong"]

# 主机命名：英文 ID 全小写、按角色命名（control 控制机、storage 存储机、overseas 海外机、factor 因子机），
# 同一角色有多台时才加序号（overseas-2）；label 是中文名，登记到管理台用于界面展示，不写时按 ID 生成（overseas-2 → 海外机 2）。
# 机器的新增、部署、启停都通过 moox skill 完成，管理台只展示。
# ssh 段：password 或 private_key_file（可加 private_key_passphrase）用于 moox-cli 登录；直达主机配了其中之一，
# 才会同步给管理台作为终端登录信息（私钥优先），没配的主机在管理台里置灰。
[hosts.control]
label = "控制机"
address = "203.0.113.10"
region = "ap-guangzhou"
provider = "tencent"
tls_mode = "auto"
ssh = { port = 22, username = "ubuntu" }

[hosts.storage]
label = "存储机"
address = "203.0.113.11"
region = "ap-nanjing"
provider = "tencent"
tls_mode = "auto"
ssh = { port = 22, username = "ubuntu" }

# 海外机：海外 IP 出口，运行交易执行与出口代理，建议放在香港。
[hosts.overseas]
label = "海外机"
address = "203.0.113.12"
region = "ap-hongkong"
provider = "tencent"
ssh = { port = 22, username = "ubuntu" }

# 因子机：运行因子引擎与归档 worker，只支持 Linux，可以是局域网或家里的机器。
# 它只能出站连接，控制台与监控经管理台服务器的网关中转（reachability = "outbound"）；
# 控制台不能 SSH 到只能出站的主机，所以不会同步它的 SSH 登录信息。
[hosts.factor]
label = "因子机"
address = "192.0.2.30"
reachability = "outbound"
ssh = { port = 22, username = "builder" }

# host-gateway 与 host-agent 由代码为每台部署主机自动补齐，无需手工列出。
[deployments]
control = ["console-proxy", "web-host", "admin", "monitor", "collector", "cloudfunction", "factor-mgr", "strategy"]
# eventbus 是独立单元，可以放在任意一台直达主机上，用 setup deploy-unit --profile eventbus 安装。放在存储机上最省跨机流量：
# Storage 内部的行变更事件（storage-node → storage-view）占 EventBus 流量的九成以上，同机之后不再经公网往返。
# 客户端与它同机时连回环地址，否则连它所在主机的对外地址。
storage = ["storage-primary", "storage-node", "storage-view", "access", "eventbus"]
# collector-stream 接收交易所 WS 推送并提供本地执行端，必须放在能直连交易所的海外机；首次安装用 setup deploy-unit --profile collector-stream。
overseas = ["trade", "access", "egress-proxy", "collector-stream"]
# factor-engine 与 archive-worker 是外部程序组件，由 setup deploy-unit 以 systemd 用户服务安装，停用主机或部署时 CLI 同时停掉服务。
factor = ["factor-engine", "archive-worker"]

[egress_proxy]
http_domains = ["*.binance.com", "data-api.binance.vision"]

[egress_proxy.dns]
refresh_interval_seconds = 300
request_timeout_ms = 3000
lookup_timeout_ms = 1500
probe_timeout_ms = 500
probe_port = 443
cache_ttl_seconds = 300
max_ips_per_domain = 4
domains = ["data-api.binance.vision", "api.binance.com", "fapi.binance.com"]
