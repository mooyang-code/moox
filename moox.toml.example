[scf_fetcher.cloud_account]
account_id = "tencent-scf"
account_name = "Tencent SCF"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_region = "ap-guangzhou"
cos_bucket = "moox-scf-<tencent-app-id>"

# 短时行情 SCF 按 Space 独立发布、独立消费任务。所有市场复用通用 market_data 包目录，
# 但每个 Space 必须声明自己的 Market、Instrument、Source 身份。
[[scf_fetcher.spaces]]
space_id = "crypto"
# 发布前必须绑定一个专用、禁用且只含一个标的的 Collector task，避免与实时 Scheduler 争抢同一 period。
# canary_task_id = "由 Collector 创建的 task ID"
entrypoint = "market_data"
market_id = "crypto"
instrument_type = "spot"
provider_id = "binance"
source_id = "spot_http"
package_config_dir = "scf/market_data"
package_name = "moox-collector-market-data-crypto"
# 每个 Space 使用独立主 namespace；单地域函数超过 50 时再创建 moox-<space>-ns2 溢出命名空间。
# 首次发布时 CloudNode 会在目标地域幂等创建这些命名空间。
namespace = "moox-crypto"
runtime = "Go1"
function_prefix = "moox-fetcher-crypto-binance"
# crypto 需要公网出口访问交易所；访问 MooX 走外部接入，由 CLI 和 Collector 按地域自动选择私网或公网。
public_net_status = "ENABLE"
region_blacklist = ["ap-guangzhou"]
# 黑名单按 Space 生效，不影响其他 Space 或广州 CLS 日志存储。
# 被禁地域的 function_count 必须为 0；总容量在允许的地域中分配。
# 南京承载现货和 Storage 同地域私网；香港承载 Binance 合约（国内 SCF 到不了 fapi）。
timer_function_count = 80
# 函数经外部接入领取 Timer 批次、写入 Storage：与函数同地域的主机上有外部接入时，函数绑定该主机所在的 VPC
# 走私网，否则走 access@storage 的公网地址（moox-cli setup scf-network-plan 可查看路由）。
memory_size = 64
timeout_seconds = 60
# Timer 与 Invoke 都要为 Storage 写入和持久化完成回执预留时间。
invoke_timeout_seconds = 60
realtime_batch_size = 10
realtime_bar_limit = 10
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

# 发布器会先完整占满 Storage 所在地域的 function_count，完成 canary/回读后再处理其他地域。
# 合约 Timer 必须落在海外地域；不要为了扩配额再开地域，香港只解决 fapi 出口。
[[scf_fetcher.spaces.regions]]
region = "ap-nanjing"
display_name = "华东地区（南京）"
enabled = true
function_count = 60

[[scf_fetcher.spaces.regions]]
region = "ap-guangzhou"
display_name = "华南地区（广州，已禁用）"
enabled = false
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-hongkong"
display_name = "Hong Kong"
enabled = true
function_count = 20

# A 股 1m 多源采集默认发布 170 个 Timer。启用地域按配置自动分配；
# probe-egress 仅用于诊断出口分布，不再作为发布或启用 Rule 的阻断门禁。
[[scf_fetcher.spaces]]
space_id = "stockcn"
# 发布前必须绑定一个专用、禁用且只含一个标的的 Collector task，避免与 Timer Scheduler 争抢同一 period。
# canary_task_id = "由 Collector 创建的 task ID"
entrypoint = "market_data"
market_id = "stockcn"
instrument_type = "equity"
source_binding_mode = "deterministic"
package_config_dir = "scf/stockcn"
package_name = "moox-collector-stockcn"
cls_cloud_account_id = "tencent-scf"
# 与 crypto 隔离 namespace；Timer 与发布辅助函数合计受配额约束。
namespace = "moox-stockcn"
runtime = "Go1"
function_prefix = "moox-fetcher-stockcn"
timer_function_count = 170
# 单个 stockcn Timer 的实测安全 subject 上限，超限时 Collector 拒绝发布。
measured_safe_group_size = 40
memory_size = 64
timeout_seconds = 60
# 仅 Invoke 辅助函数使用该独立超时。
invoke_timeout_seconds = 90
realtime_batch_size = 10
realtime_bar_limit = 10
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

# 发布器会先完整占满 Storage 所在地域的 function_count，完成 canary/回读后再处理其他地域。
[[scf_fetcher.spaces.regions]]
region = "ap-guangzhou"
display_name = "华南（广州）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-shanghai"
display_name = "华东（上海）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-beijing"
display_name = "华北（北京）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-chengdu"
display_name = "西南（成都）"
enabled = true
function_count = 0

# MooX 主机：键是主机 ID。address 是公网地址（SSH、跨主机入口和控制台都用它）；private_address 与 region 用于
# SCF 选择外部接入：同地域的 SCF 经私网地址访问，跨地域走公网地址。腾讯云主机将 provider 设为 tencent，
# 发布 SCF 时 CLI 从腾讯云查询外部接入主机的 VPC 和子网。root 省略时为 <paths.deploy_root>/<主机 ID>。
# 操作说明见 skills/moox/references/private-network.md。
[hosts.control]
address = "203.0.113.10"
root = "/data/moox/prod"
provider = "tencent"
# 控制台代理的证书：公网 IP 一般申请不到公网证书时用 internal（Caddy 内置 CA），省略时按地址自动选择。
tls_mode = "auto"
ssh = { port = 22, username = "ubuntu", password = "" }

[hosts.storage]
address = "203.0.113.11"
private_address = "10.206.0.5"
region = "ap-nanjing"
root = "/data/moox/storage"
provider = "tencent"
ssh = { port = 22, username = "ubuntu", password = "" }

[hosts.compute-1]
address = "203.0.113.12"
private_address = "172.19.32.13"
region = "ap-hongkong"
provider = "tencent"
ssh = { port = 22, username = "ubuntu", password = "" }

# 部署表：每台主机上的业务组件。主机组件（主机网关、主机采集器）每台主机自动部署，不用写。
# CLI 部署某台主机时按这张表同步它在 Admin 中的部署记录；管理台上设置的启用 / 停用状态保留。
[placements]
control = ["console-proxy", "web-host", "admin", "eventbus", "monitor", "collector", "cloudnode",
           "factor-mgr", "strategy"]
storage = ["storage-primary", "storage-node", "storage-view", "access"]
compute-1 = ["trade", "access", "egress-proxy"]

# Storage、factor-mgr 等 CGO 组件在编译主机上编译（Linux amd64，glibc 不高于生产机）。编译主机不是 MooX 主机，
# 不要使用运行中的生产机：编译 DuckDB 会占满 CPU/内存，拖慢同机的调度与 SCF 调用。
[compile_host]
address = "198.51.100.20"
ssh = { port = 22, username = "builder", password = "" }

# 出口代理：http_domains 是 Collector 经出口代理访问的域名（支持 "*." 前缀通配），没有部署出口代理时全部直连。
[egress_proxy]
http_domains = ["*.binance.com", "data-api.binance.vision"]

# 出口代理为 SCF 的 DNS 快照解析的域名。
[egress_proxy.dns]
domains = ["data-api.binance.vision", "api-gcp.binance.com", "api.binance.com", "fapi.binance.com"]
refresh_interval_seconds = 300
request_timeout_ms = 3000
lookup_timeout_ms = 1500
probe_timeout_ms = 500
probe_port = 443
cache_ttl_seconds = 300
max_ips_per_domain = 4
