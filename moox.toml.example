[admin]
username = "admin"
password = ""

[tencent_cloud]
secret_id = ""
secret_key = ""
region = "ap-guangzhou"

[eventbus]
  host = "203.0.113.10"
port = 4222
tls_enabled = true

# Only all/new are supported. Omit deliver_policy on redeploy to keep the
# installed policy; a fresh deployment defaults to all. Existing JetStream
# durable consumers must be migrated explicitly before changing this value.
[observability]
# deliver_policy = "all"

# 所有运行时目录使用云磁盘 /data 下的统一根目录。
[paths]
deploy_root = "/data/moox"
control_root = "/data/moox/prod"
storage_root = "/data/moox/storage"

# 每个本地 .log 文件达到上限后保留尾部并原地截断，避免 stdout/stderr
# 或框架日志无限占用磁盘。健康检查每分钟执行一次滚动维护。
[local_logs]
max_size_mb = 50
backup_count = 5

# View 维护策略。每个时序序列超过 max_periods_per_series 即触发 A/B 重建，
# 新 View 尝试回溯 rebuild_lookback_periods 根已完成 K 线；历史不足时使用已有数据激活，
# 后续由实时事件继续补齐。
[storage_view]
maintenance_check_interval = "1m"
rebuild_lookback_periods = 1000
max_periods_per_series = 2000
max_view_file_bytes = 1073741824

# 系统监控 View 可单独配置；省略字段继承 storage_view 全局值。
[storage_view.system_monitor]
max_periods_per_series = 2000

# 单个 View 覆盖优先级最高；省略字段继承 system_monitor 或全局值。
[[storage_view.views]]
space_id = "crypto"
view_id = "view_binance_spot_kline_1m"
rebuild_lookback_periods = 1000
max_periods_per_series = 2000

# 留空时仍采集和展示监控数据，但不发送站外告警。
[notification]
channel_type = "wecom"
webhook_url = ""

# setup init 导入本地 Python 因子，并建立默认 Source View 绑定。
# outputs 同时作为结果列的 display_name，例如 bias_20、ma_20。
# 关闭默认因子导入请设置 factors.enabled = false；也可以复制条目改成自己的 View、频率和参数。
[factors]
enabled = false
source_dir = "./modules/factor/factors"

[[factors.items]]
factor_id = "Bias"
factor_type = "timeseries"
file = "Bias.py"
name = "Bias"
input_columns = ["close"]
outputs = ["bias_5", "bias_20"]
params_json = '{"windows":[5,20]}'
lookback_periods = 20
space_id = "crypto"
source_view_id = "view_binance_spot_kline_1m"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "Cci"
factor_type = "timeseries"
file = "Cci.py"
name = "Cci"
input_columns = ["high", "low", "close"]
outputs = ["cci"]
params_json = '{"window":20}'
lookback_periods = 20
space_id = "crypto"
source_view_id = "view_binance_spot_kline_1m"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "MinMax"
factor_type = "timeseries"
file = "MinMax.py"
name = "MinMax"
input_columns = ["high", "low", "close"]
outputs = ["minmax_20"]
params_json = '{"window":20}'
lookback_periods = 20
space_id = "crypto"
source_view_id = "view_binance_spot_kline_1m"
freq = "1m"
subject_mode = "all"
status = "enabled"

[[factors.items]]
factor_id = "QuoteVolumeMean"
factor_type = "timeseries"
file = "QuoteVolumeMean.py"
name = "QuoteVolumeMean"
input_columns = ["quote_volume"]
outputs = ["quote_volume_mean_20"]
params_json = '{"window":20}'
lookback_periods = 20
space_id = "crypto"
source_view_id = "view_binance_spot_kline_1m"
freq = "1m"
subject_mode = "all"
status = "enabled"

# 短时行情 SCF 按 Space 独立发布、独立消费任务。所有市场复用通用
# market_data 包目录，但每个 Space 必须声明自己的 Market/Instrument/Source 身份。
[scf_fetcher]
enabled = false

# 腾讯云 SCF 默认配额参考（按账号/地域；购买套餐或工单调整后以实时账号配额为准）。
# 发布器按「命名空间数 × 每命名空间函数数」校验每个地域的函数总数（含 Invoke/快照辅助函数）。
# 默认 5 个命名空间 × 50 个函数 = 250。单命名空间满员后写入 moox-<space>-ns2 等溢出命名空间。
# region_limits 显式列出每个支持地域的命名空间、函数和并发内存上限；购买提额后按地域覆盖。
[scf_fetcher.tencent_limits]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
max_burst_concurrency_per_minute = 500
total_concurrency_memory_mb_by_region = { ap-beijing = 128000, ap-chengdu = 128000, ap-chongqing = 64000, ap-guangzhou = 128000, ap-nanjing = 64000, ap-shanghai = 128000, ap-shanghai-fsi = 64000, ap-shenzhen-fsi = 64000, ap-hongkong = 128000, na-ashburn = 64000, na-siliconvalley = 64000, eu-frankfurt = 64000, ap-singapore = 64000, ap-bangkok = 64000, ap-jakarta = 64000, sa-saopaulo = 64000, ap-tokyo = 64000, ap-seoul = 64000 }
reference_url = "https://cloud.tencent.com/document/product/583/11637"
reference_checked_at = "2026-09-17"

[scf_fetcher.tencent_limits.region_limits.ap-beijing]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-chengdu]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-chongqing]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-guangzhou]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-nanjing]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-shanghai]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-shanghai-fsi]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-shenzhen-fsi]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-hongkong]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.na-ashburn]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.na-siliconvalley]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.eu-frankfurt]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-singapore]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-bangkok]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-jakarta]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.sa-saopaulo]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-tokyo]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 64000
[scf_fetcher.tencent_limits.region_limits.ap-seoul]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
