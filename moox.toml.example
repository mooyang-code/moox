[admin]
username = "admin"
password = ""

[tencent_cloud]
secret_id = ""
secret_key = ""
region = "ap-guangzhou"

# 消息总线的地址取自 [placements] 中部署 eventbus 的主机。
[eventbus]
port = 4222
tls_enabled = true

# 消息总线订阅的起点策略只支持 all 和 new。重新部署时省略 deliver_policy 会保留已安装的策略，全新部署默认 all；
# 已有的 JetStream 持久消费者必须先显式迁移，才能修改这个值。
[observability]
# deliver_policy = "all"

# 主机的部署根目录默认为 <deploy_root>/<主机 ID>，也可以在 [hosts.<主机 ID>] 中用 root 单独指定。
# 所有运行时目录使用云磁盘 /data 下的统一根目录。
[paths]
deploy_root = "/data/moox"

# 每个本地 .log 文件达到上限后保留尾部并原地截断，避免 stdout/stderr
# 或框架日志无限占用磁盘。健康检查每分钟执行一次滚动维护。
[local_logs]
max_size_mb = 50
backup_count = 5

# View 只按根数保留：每个时序序列保留最近 view_bars 根已完成 K 线，历史不足时用已有数据激活，
# 后续由实时事件补齐。
# Dataset 原始数据按 (空间, 频率) 保留：空间配置优先，没有时用 defaults；defaults 必须覆盖全部频率。
# 取值为 <n>h、<n>d 或 forever。保留期缩短会删除数据，发布前用 moox-cli config plan 核对。
[storage_retention]
view_bars = 5000   # 每个序列 View 保留最近 N 根；超过 ceil(1.2 × N) 根时整理

# 7×24 小时交易的空间（crypto 等，以及没有单独配置的空间）
[storage_retention.defaults]
"30s" = "48h"
"1m" = "7d"
"5m" = "30d"
"15m" = "90d"
"30m" = "180d"
"1h" = "365d"
"4h" = "1095d"
"1d" = "forever"
"1w" = "forever"
"1mo" = "forever"

# 有交易时段的市场同样根数需要更多自然日
[storage_retention.spaces.stockcn]
"1m" = "45d"
"5m" = "240d"
"15m" = "730d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.stockhk]
"1m" = "30d"
"5m" = "240d"
"15m" = "730d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.stockus]
"1m" = "30d"
"5m" = "240d"
"15m" = "730d"
"30m" = "forever"
"1h" = "forever"
"4h" = "forever"

[storage_retention.spaces.mooxsys]
"30s" = "48h"
"1m" = "180d"

# View 维护的检查节奏与单个 View 文件上限。
[storage_view]
maintenance_check_interval = "1m"
capacity_check_interval = "1h"
capacity_check_jitter = "1h"
max_view_file_bytes = 1073741824

# Collector 的旧执行明细、terminal retry 和 period snapshot 按独立期限回收。
# 活动工作以及未获 Storage complete/degraded 确认的 K 线目标不会被删除。
# 清理在每个周期的 maintenance_offset 处开始，且必须在下一个整点前结束
# （offset + timeout <= interval），避免与整点的 K 线调度争用 SQLite 连接。
[collector_retention]
maintenance_interval = "1m"
maintenance_offset = "35s"
maintenance_timeout = "20s"
max_rows_per_pass = 50000
execution_detail_retention = "6h"
scheduled_run_summary_retention = "720h"
terminal_retry_retention = "168h"
period_snapshot_retention = "720h"

# 留空时仍采集和展示监控数据，但不发送站外告警。
[notification]
channel_type = "wecom"
webhook_url = ""

# setup init 导入本地 Python 因子：先按源数据集与频率建立因子集，再导入因子定义，
# 最后把定义加入因子集并按 status 启用。定义（factors.definitions）是全局的，不含数据集、
# 频率和状态；成员（factors.members）用 source_dataset_id + freq 指向因子集，一个定义可加入多个因子集。
# outputs 同时作为结果列的 display_name，例如 bias_20、ma_20。
# 关闭默认因子导入请设置 factors.enabled = false；也可以复制条目改成自己的数据集、频率和参数。
[factors]
enabled = false
source_dir = "./modules/factor/factors"

# 每个采集任务独占一个结果数据集，ID 由任务 ID 派生为 dataset_<task_id>
# （见 config/setup/collection-tasks.yaml）：下面两个分别是币安现货、合约 1m 任务的结果。
[[factors.sets]]
space_id = "crypto"
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
subject_mode = "all"

[[factors.sets]]
space_id = "crypto"
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
subject_mode = "all"

[[factors.definitions]]
factor_id = "Bias"
factor_type = "timeseries"
file = "Bias.py"
name = "Bias"
input_columns = ["close"]
outputs = ["bias_5", "bias_20"]
params_json = '{"windows":[5,20]}'
lookback_periods = 20

[[factors.definitions]]
factor_id = "Cci"
factor_type = "timeseries"
file = "Cci.py"
name = "Cci"
input_columns = ["high", "low", "close"]
outputs = ["cci"]
params_json = '{"window":20}'
lookback_periods = 20

[[factors.definitions]]
factor_id = "MinMax"
factor_type = "timeseries"
file = "MinMax.py"
name = "MinMax"
input_columns = ["high", "low", "close"]
outputs = ["minmax_20"]
params_json = '{"window":20}'
lookback_periods = 20

[[factors.definitions]]
factor_id = "QuoteVolumeMean"
factor_type = "timeseries"
file = "QuoteVolumeMean.py"
name = "QuoteVolumeMean"
input_columns = ["quote_volume"]
outputs = ["quote_volume_mean_20"]
params_json = '{"window":20}'
lookback_periods = 20

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
factor_id = "Bias"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
factor_id = "Cci"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
factor_id = "MinMax"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhd0"
freq = "1m"
factor_id = "QuoteVolumeMean"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
factor_id = "Bias"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
factor_id = "Cci"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
factor_id = "MinMax"
status = "enabled"

[[factors.members]]
source_dataset_id = "dataset_dasftksvjhj2jom4vhdg"
freq = "1m"
factor_id = "QuoteVolumeMean"
status = "enabled"

[scf_fetcher]
enabled = false

# 腾讯云 SCF 默认配额参考（按账号/地域；购买套餐或工单调整后以实时账号配额为准）。
# 发布器按「命名空间数 × 每命名空间函数数」校验每个地域的函数总数（含 Invoke/快照辅助函数）。
# 默认 5 个命名空间 × 50 个函数 = 250。单命名空间满员后写入 moox-<space>-ns2 等溢出命名空间。
# region_limits 显式列出每个支持地域的命名空间、函数和并发内存上限；购买提额后按地域覆盖。
[scf_fetcher.tencent_limits]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
max_burst_concurrency_per_minute = 500
total_concurrency_memory_mb_by_region = { ap-beijing = 128000, ap-chengdu = 128000, ap-chongqing = 64000, ap-guangzhou = 128000, ap-nanjing = 64000, ap-shanghai = 128000, ap-shanghai-fsi = 64000, ap-shenzhen-fsi = 64000, ap-hongkong = 128000, na-ashburn = 64000, na-siliconvalley = 64000, eu-frankfurt = 64000, ap-singapore = 64000, ap-bangkok = 64000, ap-jakarta = 64000, sa-saopaulo = 64000, ap-tokyo = 64000, ap-seoul = 64000 }
reference_url = "https://cloud.tencent.com/document/product/583/11637"
reference_checked_at = "2026-09-17"

[scf_fetcher.tencent_limits.region_limits.ap-beijing]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-chengdu]
max_namespaces_per_region = 5
max_functions_per_namespace = 50
total_concurrency_memory_mb = 128000
[scf_fetcher.tencent_limits.region_limits.ap-chongqing]
max_namespaces_per_region = 5
