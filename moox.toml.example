[scf_fetcher.cloud_account]
account_id = "tencent-scf"
account_name = "Tencent SCF"
credential_secret_id = "tencent-default"
app_id = "<tencent-app-id>"
cos_region = "ap-guangzhou"
cos_bucket = "moox-scf-<tencent-app-id>"

[[scf_fetcher.spaces]]
space_id = "crypto"
entrypoint = "market_data"
market_id = "crypto"
instrument_type = "spot"
provider_id = "binance"
source_id = "spot_http"
package_config_dir = "scf/market_data"
package_name = "moox-collector-market-data-crypto"
# 每个 Space 使用独立主 namespace；单地域函数超过 50 时再创建 moox-<space>-ns2 溢出命名空间。
# 首次发布时 CloudNode 会在目标地域幂等创建这些命名空间。
namespace = "moox-crypto"
runtime = "Go1"
function_prefix = "moox-fetcher-crypto-binance"
# crypto 需要公网出口访问交易所；Storage 数据面由 CLI 按地域自动选择私网或公网。
public_net_status = "ENABLE"
region_blacklist = ["ap-guangzhou"]
# 黑名单按 Space 生效，不影响其他 Space 或广州 CLS 日志存储。
# 被禁地域的 function_count 必须为 0；总容量在允许的地域中分配。
# 南京承载现货和 Storage 同地域私网；香港承载 Binance 合约（国内 SCF 到不了 fapi）。
timer_function_count = 80
# SCF Timer 每次直接访问该 Storage tRPC 地址，不再请求 Collector 配置接口。
storage_gateway_node_id = "control"
storage_gateway_host = "203.0.113.11"
# storage_gateway_host 是跨地域回源和故障回退地址；同地域 SCF 会自动使用
# storage_private_gateway_host 与 Storage VPC/子网。不要手工把私网地址写入公网字段。
# 可选：填写 Storage 当前私网 IP 作为提示；CLI 仍以腾讯云实例发现结果为准。
# storage_private_gateway_host = "10.0.0.5"
# 可选：按 SCF 地域接入本地无状态 Storage Access；未配置的地域继续回退到
# storage_gateway_host / storage_private_gateway_host。
# storage_access_targets = { ap-nanjing = "ip://203.0.113.11:11004", ap-hongkong = "ip://203.0.113.12:12004" }
# 可选：为每个 Access 入口配置独立 Gateway target node，避免不同地域的
# nonce/replay 语义互相混用；未配置的地域回退到 storage_gateway_node_id。
# storage_access_target_nodes = { ap-nanjing = "storage-access-nanjing", ap-hongkong = "storage-access-hongkong" }
memory_size = 64
timeout_seconds = 15
# Invoke nodes also refresh the full Binance symbol snapshot; give that
# metadata write path a longer budget while Kline Timer nodes stay short-lived.
instrument_invoke_timeout_seconds = 60
realtime_batch_size = 10
realtime_bar_limit = 10
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

# 发布器会先完整占满 Storage 所在地域的 function_count，完成 canary/回读后再处理其他地域。
# 合约 Timer 必须落在海外地域；不要为了扩配额再开地域，香港只解决 fapi 出口。
[[scf_fetcher.spaces.regions]]
region = "ap-nanjing"
display_name = "华东地区（南京）"
enabled = true
function_count = 60

    [[scf_fetcher.spaces.regions]]
region = "ap-guangzhou"
display_name = "华南地区（广州，已禁用）"
enabled = false
function_count = 0

    [[scf_fetcher.spaces.regions]]
region = "ap-hongkong"
display_name = "Hong Kong"
enabled = true
function_count = 20

# A 股 1m 多源采集默认发布 170 个 Timer。启用地域按配置自动分配；
# probe-egress 仅用于诊断出口分布，不再作为发布或启用 Rule 的阻断门禁。
[[scf_fetcher.spaces]]
space_id = "stockcn"
entrypoint = "market_data"
market_id = "stockcn"
instrument_type = "equity"
source_binding_mode = "deterministic"
package_config_dir = "scf/stockcn"
package_name = "moox-collector-stockcn"
cls_cloud_account_id = "tencent-scf"
# 与 crypto 隔离 namespace；Timer 与发布辅助函数合计受配额约束。
namespace = "moox-stockcn"
runtime = "Go1"
function_prefix = "moox-fetcher-stockcn"
# Full stock Instrument snapshot: one independent daily Timer SCF.
instrument_snapshot_region = "ap-shanghai"
instrument_snapshot_cloud_account_id = "tencent-scf"
instrument_snapshot_function_prefix = "moox-fetcher-stockcn-instrument"
instrument_snapshot_timer_cron = "0 0 0 * * * *"
instrument_snapshot_timeout_seconds = 300
instrument_snapshot_memory_size = 256
timer_function_count = 170
# 单个 stockcn Timer 的实测安全 subject 上限，超限时 Collector 拒绝发布。
measured_safe_group_size = 40
storage_gateway_node_id = "control"
storage_gateway_host = "203.0.113.11"
# Storage 同地域的 SCF 自动使用私网 VPC 路径；跨地域自动回退到 storage_gateway_host。
memory_size = 64
timeout_seconds = 15
# 全市场 Instrument 快照实测约 25 秒；仅 Invoke 辅助函数使用该独立超时。
instrument_invoke_timeout_seconds = 60
realtime_batch_size = 10
realtime_bar_limit = 10
catchup_batch_size = 1
catchup_bar_limit = 1000
max_inflight_requests = 10
request_timeout_ms = 2000
http_max_attempts = 4
storage_max_attempts = 1
storage_timeout_ms = 5000
max_retry_attempts = 3
retry_delays = ["5s", "30s", "2m"]
stagger_enabled = false

# 发布器会先完整占满 Storage 所在地域的 function_count，完成 canary/回读后再处理其他地域。
[[scf_fetcher.spaces.regions]]
region = "ap-guangzhou"
display_name = "华南（广州）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-shanghai"
display_name = "华东（上海）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-beijing"
display_name = "华北（北京）"
enabled = true
function_count = 0

[[scf_fetcher.spaces.regions]]
region = "ap-chengdu"
display_name = "西南（成都）"
enabled = true
function_count = 0

# 腾讯云主机将 provider 设为 tencent。CLI 会从 storage_host 发现 Storage 的
# 地域、VPC、子网和私网地址；同地域 SCF 绑定该 VPC，跨地域不创建 CCN 而走
# storage_gateway_host。SSH 和控制台入口仍使用主机公网地址。
# 操作说明见 skills/moox/references/private-network.md。
[hosts."203.0.113.10"]
  port = 22
  username = "ubuntu"
  password = ""
  provider = "tencent"

[hosts."203.0.113.11"]
  port = 22
  username = "ubuntu"
  password = ""
  provider = "tencent"

[hosts."203.0.113.12"]
  port = 22
  username = "ubuntu"
  password = ""
  provider = "tencent"

[control_host]
  name = "control"
  host = "203.0.113.10"
# Raw public IPs normally cannot obtain a public ACME certificate. Use the
# bundled Caddy internal CA in that case; omit this field for host-based auto.
  tls_mode = "auto"

[storage_host]
  name = "storage"
  host = "203.0.113.11"
  tls_mode = "auto"

[view_host]
  name = "view"
  host = "203.0.113.11"
  tls_mode = "auto"

[compile_host]
  name = "compile"
  host = "203.0.113.10"

[[other_hosts]]
  name = "compute-1"
  host = "203.0.113.12"

# moox-cli renders the non-sensitive resolver fields below into Trade's
# config/app.yaml. When enabled, trade_node is also the dedicated Trade
# execution host; deploy-control records its TradeConsole endpoint in the
# control-plane route so the browser does not fall back to 127.0.0.1:11200.
# setup deploy-service binds the dedicated Trade listener on all interfaces
# because the SSH/public address may be NAT'ed; restrict TCP 11200 in the
# cloud firewall to control_host before enabling real order operations.
# Trade does not read this full moox.toml directly.
[dns_resolver]
enabled = false
trade_node = "compute-1"
refresh_interval_seconds = 300
request_timeout_ms = 3000
lookup_timeout_ms = 1500
probe_timeout_ms = 500
probe_port = 443
cache_ttl_seconds = 300
max_ips_per_domain = 4
domains = ["data-api.binance.vision", "api.binance.com", "fapi.binance.com"]
