# 复制到 ~/.moox-release.env（不入库、不要提交）后按实际填写；native-release.sh 启动时读取。
# 只写 user@host，SSH 一律走公钥，不要写密码。
MOOX_RELEASE_HOST_CONTROL=ubuntu@<控制机地址>
MOOX_RELEASE_HOST_STORAGE=ubuntu@<Storage 主机地址>
MOOX_RELEASE_HOST_OVERSEAS=ubuntu@<海外机地址>
# 取回的二进制放哪，默认 $TMPDIR/moox-release/<提交>/
# MOOX_RELEASE_OUT=/tmp/moox-release
