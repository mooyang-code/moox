# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test


**/.claude/
.superpowers/
.worktrees/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Python bytecode/cache artifacts
__pycache__/
*.py[cod]

# 系统与本机工具产生的文件
.DS_Store
.zcode/

# 执行计划只留在本机，不进 Git
docs/计划/

# env file
.env

# 本机的部署配置：明文的 moox.toml 与加密的 moox.secrets.toml，只提交示例文件。
/moox.toml
# 改名备份的旧配置可能含明文凭据（示例文件除外）
/moox.toml.*
!/moox.toml.example
/moox.secrets.toml
/moox.secrets.toml.*
!/moox.secrets.toml.example

# Local Cursor MCP config contains the remote bearer token.
.cursor/mcp.json

# Local skill credentials and production live probes. Never commit.
skills/moox/config/data-access.yaml
skills/moox/config/.moox-skill-keys/
modules/cli/internal/command/live_factor_read_test.go

# infra 真实部署值覆盖文件（唯一存放真实 IP/凭证处），不入库


server/.claude/

# Monorepo runtime/build artifacts. 真实运行数据应放到部署目录或 var，
# 仓库中只保留源码、配置模板、schema、文档和测试样例。
/bin/
/bin-linux/
/data/
/log/
/logs/
/var/
/release/
/dist/
/web/dist/
/coverage/
/modules/*/bin/
/modules/*/data/
/modules/*/factors/.versions/
/modules/*/log/
/modules/*/logs/
/modules/*/var/
/modules/*/release/
/modules/*/dist/
/modules/*/coverage/
/modules/*/.cache/
/modules/*/scf-build/
/modules/storage/.deps/
/scripts/node_exporter/build/
cover.out
cover.out.tmp

# Runtime SQLite artifacts. Schema SQL belongs in module schema directories;
# runtime database files are rebuilt from service startup and examples flows.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

*.log
*.zip
*.tmp

# trpc-open temporary generation workspaces
/modules/*/proto/*/tmp-*/

# Editor/IDE
# .idea/
# .vscode/

# Local debug screenshots at repo root
/*.png

# 构建 admin 时 scripts/build/build.sh 临时拷进来内嵌的前端（编译完即删），只提交占位文件
/modules/admin/internal/webui/dist/*
!/modules/admin/internal/webui/dist/.gitkeep

# VitePress
node_modules/
/.pnpm-store/
docs/.vitepress/dist/
docs/.vitepress/cache/

# local build toolchain cache
/.toolchain/

# Module-local build outputs
/modules/admin/cmd/cli/cli
/modules/storage/cmd/cli/cli

# 误执行 go build 产生的二进制
sdk/rust/target/
/modules/importer/
/tools/zstddict/zstddict
