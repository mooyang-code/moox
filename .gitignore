# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test


**/.claude/
.superpowers/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Python bytecode/cache artifacts
__pycache__/
*.py[cod]

# Go workspace file
go.work.sum

# env file
.env
skills/dev-helper/.env.local

# infra 真实部署值覆盖文件（唯一存放真实 IP/凭证处），不入库


server/.claude/

# Monorepo runtime/build artifacts. 真实运行数据应放到部署目录或 var，
# 仓库中只保留源码、配置模板、schema、文档和测试样例。
/bin/
/data/
/log/
/logs/
/var/
/release/
/dist/
/web/dist/
/coverage/
/modules/*/bin/
/modules/*/data/
/modules/*/log/
/modules/*/logs/
/modules/*/var/
/modules/*/release/
/modules/*/dist/
/modules/*/coverage/
/modules/*/.cache/
/modules/*/scf-build/
/modules/collector/collector-scf-*.zip
/modules/storage/.deps/
/scripts/node_exporter/build/
cover.out
cover.out.tmp

# Runtime SQLite artifacts. Schema SQL belongs in module schema directories;
# runtime database files are rebuilt from service startup and examples flows.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

*.log

**/trpc_go.yaml

# Editor/IDE
# .idea/
# .vscode/

# Local debug screenshots at repo root
/*.png

# Local web-host build artifact (use ./bin)
/web-host/web-host
/web-host/moox-web-host

# VitePress
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
